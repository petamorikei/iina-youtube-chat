{
  "name": "iina-youtube-chat",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:plugin": "vite build --config vite.config.plugin.ts --watch",
    "build": "pnpm run build:clean && pnpm run build:typecheck && pnpm run build:sidebar && pnpm run build:plugin && pnpm run build:copy-files",
    "build:clean": "rm -rf dist",
    "build:typecheck": "tsc -b",
    "build:sidebar": "vite build",
    "build:plugin": "vite build --config vite.config.plugin.ts",
    "build:copy-files": "cp plugin/preferences.html dist/",
    "check": "biome check --write .",
    "preview": "vite preview",
    "preinstall": "npx only-allow pnpm",
    "prepare": "panda codegen && mise exec -- prek install",
    "test": "vitest"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@pandacss/dev": "^1.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "iina-plugin-definition": "^0.99.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
