{
  "name": "YouTube Chat",
  "identifier": "io.github.petamorikei.iina-youtube-chat",
  "version": "0.8.0",
  "ghRepo": "petamorikei/iina-youtube-chat",
  "ghVersion": 8,
  "author": {
    "name": "petamorikei",
    "url": "https://github.com/petamorikei"
  },
  "description": "Display YouTube live chat synchronized with video playback",
  "entry": "dist/main.js",
  "permissions": ["file-system", "network-request"],
  "allowedDomains": ["youtube.com", "www.youtube.com"],
  "sidebarTab": {
    "name": "Chat"
  },
  "preferencesPage": "dist/preferences.html",
  "preferenceDefaults": {
    "maxMessages": 200,
    "scrollDirection": "bottom-to-top",
    "showTimestamp": true,
    "showAuthorName": true,
    "showAuthorPhoto": true,
    "autoOpenChatWindow": true,
    "fontScale": 100
  }
}
